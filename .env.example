# HTTP server port for the monitoring agent API (default: 8090)
LINUX_SERVER_MONITOR_PORT=8090

# Metrics sync: endpoint to POST metrics to (default: https://kubana.cloud/api/metrics)
METRICS_SYNC_URL=https://api.kubana.cloud/api/servers/1/metrics

# Metrics sync: interval in seconds between syncs (default: 10)
METRICS_SYNC_INTERVAL_SECONDS=10

# Set to "true" to disable metrics sync to the external endpoint
# METRICS_SYNC_DISABLED=false
